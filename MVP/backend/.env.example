# Database Connection
DATABASE_URL=mysql+pymysql://museum_app_user:app_password_456@localhost:3306/smart_museum?charset=utf8mb4

# Security & JWT
# Generate a unique 256-bit key with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
IDLE_TIMEOUT_MINUTES=30
BCRYPT_ROUNDS=12
ENVIRONMENT=development

# PayOS Sandbox Credentials (VietQR Domestic Payments)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# PayPal Sandbox Credentials (International Cards & PayPal Accounts)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD
PAYPAL_EXCHANGE_RATE=25000.0

# Service Fee Configuration
AUDIO_GUIDE_SERVICE_FEE=50000
SERVICE_FEE_CURRENCY=VND

# AI & Cloud Translation Settings (US 04.4)
GEMINI_API_KEYS=
GOOGLE_TRANSLATE_API_KEYS=
GEMINI_MODEL=gemini-1.5-flash
OFFLINE_TRANSLATOR_URL=http://localhost:8001
OPENROUTER_API_KEY=
OPENROUTER_MODEL=stealth/crouton-alpha
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TRANSLATION_PROVIDERS_ORDER=openrouter,offline,google_cloud,gemini,deep_translator

# Cloud Object Storage (Supabase Storage for persistent media CDN)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET_NAME=museum-media
