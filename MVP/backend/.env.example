# Database Connection
DATABASE_URL=mysql+pymysql://museum_app_user:app_password_456@localhost:3306/smart_museum?charset=utf8mb4

# Security & JWT
# Generate a unique 256-bit key with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
IDLE_TIMEOUT_MINUTES=30
BCRYPT_ROUNDS=12
ENVIRONMENT=development
# Optional: Enable payment simulation endpoints even when ENVIRONMENT=production (Useful for deployed demo/staging)
ENABLE_PAYMENT_SIMULATION=false

# PayOS Sandbox Credentials (VietQR Domestic Payments)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# PayPal Sandbox Credentials (International Cards & PayPal Accounts)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_CURRENCY=USD
PAYPAL_EXCHANGE_RATE=25000.0

# Service Fee Configuration
AUDIO_GUIDE_SERVICE_FEE=50000
SERVICE_FEE_CURRENCY=VND

# AI & Cloud Translation Settings (US 04.4 - Auto_Translate & OpenRouter)
RENDER_TRANSLATION_API_URL=https://translation-temporary.onrender.com
RENDER_TRANSLATION_TIMEOUT=70.0
RENDER_COLD_START_RETRY_DELAY=10.0
RENDER_KEEP_ALIVE_ENABLED=false
RENDER_KEEP_ALIVE_INTERVAL_SECONDS=600
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TRANSLATION_PROVIDERS_ORDER=render_api,openrouter

# Cloud Object Storage (Supabase Storage for persistent media CDN)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET_NAME=museum-media
