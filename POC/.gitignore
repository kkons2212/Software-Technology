# ============================================================
# Root .gitignore — Smart Museum POC
# ============================================================

# ── OS / Editor ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.idea/
.vscode/settings.json
*.sublime-workspace

# ── Python / Backend ─────────────────────────────────────────
backend/.venv/
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
backend/*.egg-info/
backend/dist/
backend/build/
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/

# Database — KHÔNG commit file db thật vào git
# (người dùng mới sẽ tự tạo db khi chạy lần đầu)
backend/data/*.db
backend/data/*.db-shm
backend/data/*.db-wal

# File static được sinh tự động (audio, ảnh QR, ảnh upload)
# Giữ cấu trúc thư mục bằng .gitkeep
backend/static/audio/
backend/static/qr/
backend/static/images/
!backend/static/audio/.gitkeep
!backend/static/qr/.gitkeep
!backend/static/images/.gitkeep

# ── Node / Frontend ──────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/

# ── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Môi trường / bí mật ──────────────────────────────────────
.env
.env.local
.env.production
.env.*.local
*.pem
*.key
